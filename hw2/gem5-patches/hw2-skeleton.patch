@@ -0,0 +1,41 @@
+/*
+ * CS 423 HW2 — Bonus Task 5 (route B) skeleton: your own L1D prefetcher
+ * (see hw2_custom.hh).
+ */
+#include "mem/cache/prefetch/hw2_custom.hh"
+
+#include "params/HW2CustomPrefetcher.hh"
+
+namespace gem5
+{
+
+namespace prefetch
+{
+
+HW2Custom::HW2Custom(const HW2CustomPrefetcherParams &p)
+    : Queued(p), degree(p.degree), table(p.table_entries)
+{
+}
+
+void
+HW2Custom::calculatePrefetch(const PrefetchInfo &pfi,
+                             std::vector<AddrPriority> &addresses,
+                             const CacheAccessor &cache)
+{
+    const Addr blk = blockAddress(pfi.getAddr());
+
+    if (pfi.hasPC()) {
+        // Remember this load's last block (direct-mapped by PC).
+        Entry &e = table[(pfi.getPC() >> 2) % table.size()];
+        e.valid = true;
+        e.pc = pfi.getPC();
+        e.lastBlock = blk;
+    }
+
+    // As shipped: next-line prefetching of `degree` blocks.
+    for (int d = 1; d <= degree; d++)
+        addresses.push_back(AddrPriority(blk + d * blkSize, 0));
+}
+
+} // namespace prefetch
+} // namespace gem5
