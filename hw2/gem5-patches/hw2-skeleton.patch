@@ -0,0 +1,110 @@
+/*
+ * CS 423 HW2 — Bonus Task 5 (route B) skeleton: your own direction
+ * predictor (see hw2_custom_bp.hh for the call protocol).
+ */
+#include "cpu/pred/hw2_custom_bp.hh"
+
+#include "base/intmath.hh"
+#include "base/logging.hh"
+
+namespace gem5
+{
+
+namespace branch_prediction
+{
+
+HW2CustomBP::HW2CustomBP(const HW2CustomBPParams &params)
+    : ConditionalPredictor(params),
+      tableSize(params.tableSize),
+      historyBits(params.historyBits),
+      historyMask(mask(params.historyBits)),
+      counters(params.tableSize, SatCounter8(2)),
+      ghr(params.numThreads, 0)
+{
+    fatal_if(!isPowerOf2(tableSize), "HW2CustomBP: tableSize must be a "
+             "power of 2");
+    fatal_if(historyBits > 32, "HW2CustomBP: historyBits must be <= 32");
+}
+
+unsigned
+HW2CustomBP::indexOf(Addr pc, uint64_t hist) const
+{
+    return ((pc >> instShiftAmt) ^ hist) & (tableSize - 1);
+}
+
+void
+HW2CustomBP::shiftIn(ThreadID tid, bool taken)
+{
+    ghr[tid] = ((ghr[tid] << 1) | (taken ? 1 : 0)) & historyMask;
+}
+
+bool
+HW2CustomBP::lookup(ThreadID tid, Addr pc, void * &bp_history)
+{
+    History *h = new History;
+    h->ghr = ghr[tid];
+    h->index = indexOf(pc, ghr[tid]);
+    h->pred = counters[h->index] >= 2;      // upper half: predict taken
+    bp_history = h;
+    return h->pred;
+}
+
+void
+HW2CustomBP::branchPlaceholder(ThreadID tid, Addr pc, bool uncond,
+                               void * &bp_history)
+{
+    // Called for a branch the BTB did not know; record the history only.
+    History *h = new History;
+    h->ghr = ghr[tid];
+    h->index = indexOf(pc, ghr[tid]);
+    h->pred = true;
+    bp_history = h;
+}
+
+void
+HW2CustomBP::updateHistories(ThreadID tid, Addr pc, bool uncond, bool taken,
+                             Addr target, const StaticInstPtr &inst,
+                             void * &bp_history)
+{
+    if (uncond) {                           // no lookup() happened
+        History *h = new History;
+        h->ghr = ghr[tid];
+        h->index = indexOf(pc, ghr[tid]);
+        h->pred = true;
+        bp_history = h;
+    }
+    shiftIn(tid, taken);                    // speculative history update
+}
+
+void
+HW2CustomBP::squash(ThreadID tid, void * &bp_history)
+{
+    History *h = static_cast<History *>(bp_history);
+    ghr[tid] = h->ghr;                      // undo the speculative update
+    delete h;
+    bp_history = nullptr;
+}
+
+void
+HW2CustomBP::update(ThreadID tid, Addr pc, bool taken, void * &bp_history,
+                    bool squashed, const StaticInstPtr &inst, Addr target)
+{
+    History *h = static_cast<History *>(bp_history);
+    if (squashed) {
+        // This branch was mispredicted: rebuild the history with its real
+        // outcome. Tables are trained only at commit (below).
+        ghr[tid] = h->ghr;
+        shiftIn(tid, taken);
+        return;
+    }
+    // Commit: train the counter that made the prediction.
+    if (taken)
+        counters[h->index]++;
+    else
+        counters[h->index]--;
+    delete h;
+    bp_history = nullptr;
+}
+
+} // namespace branch_prediction
+} // namespace gem5
diff --git a/src/cpu/pred/hw2_custom_bp.hh b/src/cpu/pred/hw2_custom_bp.hh
new file mode 100644
index 0000000..4f6944f
--- /dev/null
+++ b/src/cpu/pred/hw2_custom_bp.hh
@@ -0,0 +1,73 @@
+/*
+ * CS 423 HW2 — Bonus Task 5 (route B) skeleton: your own direction
+ * predictor. As shipped it is a "gshare" predictor: one table of 2-bit
+ * counters indexed by (PC XOR global history). Storage as shipped:
+ * tableSize x 2 + historyBits bits. Change it into your design.
+ *
+ * Protocol (how the branch unit calls a direction predictor, in order):
+ *   lookup()           at fetch: predict; allocate a history record
+ *   updateHistories()  right after: update the SPECULATIVE histories with
+ *                      the predicted outcome (allocates the record for
+ *                      unconditional branches, which skip lookup())
+ *   squash()           the branch was on a wrong path: undo its history
+ *                      update and free the record
+ *   update(squashed=true)   the branch itself was mispredicted: repair the
+ *                      histories with the real outcome (keep the record)
+ *   update(squashed=false)  the branch commits: train the tables, free
+ *                      the record
+ */
+#ifndef __CPU_PRED_HW2_CUSTOM_BP_HH__
+#define __CPU_PRED_HW2_CUSTOM_BP_HH__
+
+#include <vector>
+
+#include "base/sat_counter.hh"
+#include "base/types.hh"
+#include "cpu/pred/conditional.hh"
+#include "params/HW2CustomBP.hh"
+
+namespace gem5
+{
+
+namespace branch_prediction
+{
+
+class HW2CustomBP : public ConditionalPredictor
+{
+  public:
+    HW2CustomBP(const HW2CustomBPParams &params);
+
+    bool lookup(ThreadID tid, Addr pc, void * &bp_history) override;
+    void branchPlaceholder(ThreadID tid, Addr pc, bool uncond,
+                           void * &bp_history) override;
+    void updateHistories(ThreadID tid, Addr pc, bool uncond, bool taken,
+                         Addr target, const StaticInstPtr &inst,
+                         void * &bp_history) override;
+    void squash(ThreadID tid, void * &bp_history) override;
+    void update(ThreadID tid, Addr pc, bool taken, void * &bp_history,
+                bool squashed, const StaticInstPtr &inst,
+                Addr target) override;
+
+  private:
+    /** What a branch remembers between prediction and commit. */
+    struct History
+    {
+        uint64_t ghr;      // global history BEFORE this branch
+        unsigned index;    // table index used for the prediction
+        bool pred;         // predicted direction
+    };
+
+    unsigned indexOf(Addr pc, uint64_t ghr) const;
+    void shiftIn(ThreadID tid, bool taken);
+
+    const unsigned tableSize;
+    const unsigned historyBits;
+    const uint64_t historyMask;
+    std::vector<SatCounter8> counters;
+    std::vector<uint64_t> ghr;   // one global history register per thread
+};
+
+} // namespace branch_prediction
+} // namespace gem5
+
+#endif // __CPU_PRED_HW2_CUSTOM_BP_HH__
