@@ -0,0 +1,55 @@
+/*
+ * CS 423 HW2 — Bonus Task 5 (route B) skeleton: your own L1D prefetcher.
+ * As shipped: a PC-indexed table (direct-mapped, table_entries entries)
+ * that remembers each load's last block address, and a next-line
+ * prefetch of `degree` blocks. Change it into your design.
+ *
+ * calculatePrefetch() is called on every access that notifies the
+ * prefetcher (demand misses and hits on prefetched blocks, as configured).
+ * Useful members of PrefetchInfo: getAddr(), hasPC(), getPC(),
+ * isCacheMiss(), isWrite(). Push candidates with
+ *   addresses.push_back(AddrPriority(addr, 0));
+ * (the queue drops candidates that cross a 4 KiB page or that are already
+ * cached or in flight).
+ */
+#ifndef __MEM_CACHE_PREFETCH_HW2_CUSTOM_HH__
+#define __MEM_CACHE_PREFETCH_HW2_CUSTOM_HH__
+
+#include <vector>
+
+#include "mem/cache/prefetch/queued.hh"
+#include "mem/packet.hh"
+
+namespace gem5
+{
+
+struct HW2CustomPrefetcherParams;
+
+namespace prefetch
+{
+
+class HW2Custom : public Queued
+{
+  protected:
+    struct Entry
+    {
+        bool valid = false;
+        Addr pc = 0;          // tag
+        Addr lastBlock = 0;   // last block address of this load
+    };
+
+    const int degree;
+    std::vector<Entry> table;
+
+  public:
+    HW2Custom(const HW2CustomPrefetcherParams &p);
+
+    void calculatePrefetch(const PrefetchInfo &pfi,
+                           std::vector<AddrPriority> &addresses,
+                           const CacheAccessor &cache) override;
+};
+
+} // namespace prefetch
+} // namespace gem5
+
+#endif // __MEM_CACHE_PREFETCH_HW2_CUSTOM_HH__
